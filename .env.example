# Copy to .env and fill in. Never commit .env.

SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-50
DEBUG=False
ALLOWED_HOSTS=inventory.ioref.org,localhost
CSRF_TRUSTED_ORIGINS=https://inventory.ioref.org

# SQLite is the default and needs no setting at all. Postgres is opt-in:
# DATABASE_URL=postgres://ioref:ioref@db:5432/ioref

# Read-only HTML browsing at /. Prices and suppliers are withheld from
# anonymous visitors regardless of this setting; set it False where even stock
# levels should require a login.
PUBLIC_BROWSE=True

TIME_ZONE=America/New_York
LOG_LEVEL=INFO

# Set when running behind Apache/nginx so Django trusts X-Forwarded-Proto.
SECURE_PROXY=True

# ---------------------------------------------------------------------------
# How people sign in: local | shib | oidc
# API keys work in every mode -- this only governs human logins.
# ---------------------------------------------------------------------------
AUTH_MODE=local

# --- AUTH_MODE=shib --------------------------------------------------------
# Header names as your mod_shib config exports them. The proxy MUST overwrite
# these on every request; see deploy/apache/inventory.conf.
#
# The username is the eppn (user@andrew.cmu.edu at CMU), not a bare Andrew ID:
# it is unique across the federation and maps onto Entra's UPN later. Changing
# this after users exist creates a duplicate account for every one of them.
# REMOTE_USER_HEADER=HTTP_EPPN
# REMOTE_USER_EMAIL_HEADER=HTTP_MAIL
# REMOTE_USER_NAME_HEADER=HTTP_DISPLAYNAME
#
# Optional. A permanent, opaque identifier (eduPersonUniqueId or the SAML
# persistent NameID). When released it takes precedence over the eppn when
# matching an existing account, so a rename follows the person and a reissued
# eppn does not inherit the previous holder's history. Omit if unreleased.
# REMOTE_USER_SUBJECT_HEADER=HTTP_PERSISTENT_ID
#
# LOGIN_URL=/Shibboleth.sso/Login

# --- AUTH_MODE=oidc (Entra) ------------------------------------------------
# Also: uv add mozilla-django-oidc
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# OIDC_OP_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/authorize
# OIDC_OP_TOKEN_ENDPOINT=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
# OIDC_OP_USER_ENDPOINT=https://graph.microsoft.com/oidc/userinfo
# OIDC_OP_JWKS_ENDPOINT=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys

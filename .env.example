# Local/development configuration.
#
# Copy this file to .env and fill in the deployment-specific values:
#
#   cp .env.example .env
#
# Never commit .env.
#
# Production deployments may instead keep configuration outside the repository,
# for example:
#
#   /etc/ioref-inventory/ioref-inventory.env
#
# and run Compose with:
#
#   ENV_FILE=/etc/ioref-inventory/ioref-inventory.env docker compose up -d
#
# Podman can use the same file directly with:
#
#   podman run --env-file /etc/ioref-inventory/ioref-inventory.env ...

SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-50

DEBUG=False

ALLOWED_HOSTS=inventory.ioref.org,localhost
CSRF_TRUSTED_ORIGINS=https://inventory.ioref.org

# SQLite is the default and needs no setting at all.
#
# PostgreSQL is opt-in. When using the Compose postgres profile, set a strong
# POSTGRES_PASSWORD and enable DATABASE_URL:
#
# DATABASE_URL=postgres://ioref:change-me@db:5432/ioref
# POSTGRES_USER=ioref
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=ioref

# Read-only HTML browsing at /. Prices and suppliers are withheld from
# anonymous visitors regardless of this setting; set it False where even stock
# levels should require a login.
PUBLIC_BROWSE=True

TIME_ZONE=America/New_York
LOG_LEVEL=INFO

# Set when running behind Apache/nginx so Django trusts X-Forwarded-Proto.
SECURE_PROXY=True

# ---------------------------------------------------------------------------
# How people sign in: local | shib | oidc
# API keys work in every mode -- this only governs human logins.
# ---------------------------------------------------------------------------

AUTH_MODE=local

# --- AUTH_MODE=shib --------------------------------------------------------
#
# Header names as your mod_shib config exports them. The proxy MUST overwrite
# these on every request. The vhost is not in this repository; see the
# deployment notes in CLAUDE.md.
#
# The username is the eppn (user@andrew.cmu.edu at CMU), not a bare Andrew ID:
# it is unique across the federation and maps onto Entra's UPN later. Changing
# this after users exist creates a duplicate account for every one of them.
#
# REMOTE_USER_HEADER=HTTP_EPPN
# REMOTE_USER_EMAIL_HEADER=HTTP_MAIL
# REMOTE_USER_NAME_HEADER=HTTP_DISPLAYNAME
#
# Optional. A permanent, opaque identifier. When released it takes precedence
# over the eppn when matching an existing account, so a rename follows the
# person and a reissued eppn does not inherit the previous holder's history.
# Omit if unreleased.
#
# Which header carries it depends on what the IdP releases, and there are three
# candidates: subject-id, pairwise-id and persistent-id. Check what actually
# arrives before setting this, in /Shibboleth.sso/Session or in shibd's
# transaction log, rather than assuming the default below. A name that is never
# sent is indistinguishable from no identifier at all: the app quietly falls
# back to matching on eppn.
#
# REMOTE_USER_SUBJECT_HEADER=HTTP_PERSISTENT_ID
#
# LOGIN_URL is root-absolute, not relative to any mount point: the SP handler
# is served by Apache at the top of the host. Django appends ?next=, which
# Shibboleth ignores in favour of ?target=, so people land at the SP default
# rather than where they started. Add an explicit target if that matters.
#
# LOGIN_URL=/Shibboleth.sso/Login
#
# Set when the app is served under a path on a host it shares with the
# frontdoor. gunicorn puts this in the WSGI environ and Django prefixes the
# URLs it generates; Apache strips the same prefix on the way in.
#
# SCRIPT_NAME=/inventory

# --- AUTH_MODE=oidc (Entra) ------------------------------------------------
#
# Also: uv add mozilla-django-oidc
#
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# OIDC_OP_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/authorize
# OIDC_OP_TOKEN_ENDPOINT=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
# OIDC_OP_USER_ENDPOINT=https://graph.microsoft.com/oidc/userinfo
# OIDC_OP_JWKS_ENDPOINT=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
